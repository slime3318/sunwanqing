# 服务端口
PORT=4000
NODE_ENV=development

# MongoDB 连接串
# 本地: mongodb://127.0.0.1:27017/marathon
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marathon?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/marathon

# JWT 密钥，生产环境务必替换为随机长字符串
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173

# 短信/邮件服务开关：mock = 控制台输出验证码，不真实发送
SMS_PROVIDER=mock
MAIL_PROVIDER=mock

# 支付渠道开关：mock = 模拟支付，直接置为已支付
PAYMENT_PROVIDER=mock

# 超级管理员种子账号
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_EMAIL=admin@marathon.local
SEED_ADMIN_PASSWORD=Admin123456
